# Copy to .env.local (gitignored).
# Google Map Tiles API key — client-exposed, so key-restrict it in the Google
# Cloud console: API restriction = "Map Tiles API", website restriction = your
# domains + localhost. Google layers are hidden when unset.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Copernicus Data Space (CDSE) Sentinel Hub OGC instance ID — create at
# https://shapps.dataspace.copernicus.eu/dashboard/ → Configuration Utility →
# New configuration (Sentinel-2 L2A template), then copy the configuration's Id.
# The Sentinel-2 layer is hidden when unset. Free tier: 10k requests/month.
NEXT_PUBLIC_SENTINEL_INSTANCE_ID=

# Tracestrack Topo API key — client-exposed, same referrer-restriction
# caveat as the Google key above. Free for non-commercial use per
# Tracestrack's own terms; sign up at https://www.tracestrack.com/.
# The Tracestrack Topo layer is hidden when unset.
NEXT_PUBLIC_TRACESTRACK_KEY=
